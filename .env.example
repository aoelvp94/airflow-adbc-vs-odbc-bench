# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqDDho=
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__API_AUTH__JWT_SECRET=a448e6c89b9e3f0e0a4e3c7c5e5f6a8b
AIRFLOW__API__EXPOSE_CONFIG=true

# Benchmark Configuration
# Single volume knob for every DAG (insert, select, transfer, operators, DuckDB, SQLite).
# 1000000 = 10x the original insert/select default; override locally if needed.
BENCH_ROW_COUNT=1000000
BENCH_BATCH_SIZE=1000

# Target PostgreSQL Database (for benchmarks)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=benchuser
POSTGRES_PASSWORD=benchpass
POSTGRES_DB=benchdb

# ODBC uses the same Postgres via unixODBC+psqlODBC (postgres_odbc). No MSSQL service.

# File-backed local engines (no extra compose service)
BENCH_DATA_DIR=/opt/airflow/include/data
DUCKDB_PATH=/opt/airflow/include/data/bench.duckdb
SQLITE_PATH=/opt/airflow/include/data/bench.sqlite

# Airflow Metadata Database
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=airflow
POSTGRES_AIRFLOW_DB=airflow
